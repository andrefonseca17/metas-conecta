# Copie este arquivo para .env e preencha os valores:  cp .env.example .env

# Endereço do painel (o domínio precisa apontar para o IP da VPS)
DOMINIO=metas.suaempresa.com.br
BASE_URL=https://metas.suaempresa.com.br

# Senha do banco de dados (invente uma senha longa; não precisa decorar)
DB_PASSWORD=troque-por-uma-senha-longa

# Primeiro administrador (criado só na primeira vez que o sistema sobe)
ADMIN_NAME=André Fonseca
ADMIN_EMAIL=andre@suaempresa.com.br
ADMIN_PASSWORD=TroqueEssaSenha123
ADMIN_CARGO=Analista de Redes

# Cookies só por HTTPS. Use "false" apenas se for acessar sem HTTPS (ex.: http://IP:3000 na rede interna).
COOKIE_SECURE=true

# E-mail (opcional). Com isso preenchido, convites e "Esqueci minha senha" são enviados por e-mail.
# Sem isso, o administrador copia o link na tela e envia pelo WhatsApp/Teams.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Painel de Metas <metas@suaempresa.com.br>
